---
const home = '/artifacts/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found | Artifacts</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        color: #f8f5ee;
        background: #151816;
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
      }

      main {
        width: min(38rem, calc(100% - 3rem));
      }

      p:first-child {
        color: #ff8a5b;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin-block: 0.5rem 1rem;
        font-size: clamp(3rem, 10vw, 6rem);
        letter-spacing: -0.06em;
        line-height: 0.92;
      }

      p {
        color: #bbb7ae;
        font-size: 1.1rem;
        line-height: 1.6;
      }

      a {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.45rem;
        color: #151816;
        background: #ff8a5b;
        font-weight: 700;
        text-decoration: none;
      }

      a:focus-visible {
        outline: 3px solid #f8f5ee;
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <p>404 · Repository not found</p>
      <h1>Lost ref.</h1>
      <p>This documentation path does not exist or has moved.</p>
      <a href={home}>Return to the docs</a>
    </main>
  </body>
</html>
