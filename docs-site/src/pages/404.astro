---
import BrandMark from '../components/BrandMark.astro';
import '../styles/custom.css';
import '../styles/orbital.css';
const home = '/artifacts/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found | Artifacts</title>
    <link rel="icon" href="/artifacts/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: dark;
        font-family: var(--sl-font);
        color: var(--sl-color-gray-1);
        background: var(--sl-color-black);
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
      }

      main {
        position: relative;
        box-sizing: border-box;
        width: min(42rem, calc(100% - 3rem));
        border: 1px solid var(--sl-color-gray-5);
        padding: clamp(1.5rem, 5vw, 3rem);
        background: radial-gradient(ellipse at top right, #7aa2f717, transparent 70%);
      }

      main::before { content: ''; position: absolute; top: -1px; left: -1px; width: 32px; height: 1px; background: var(--frame-accent); }

      .error-label {
        color: var(--frame-accent);
        font-family: var(--sl-font-mono);
        font-size: .65rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin-block: 0.5rem 1rem;
        font-size: clamp(3rem, 10vw, 6rem);
        font-family: var(--font-display);
        font-weight: 500;
        letter-spacing: .025em;
        text-transform: uppercase;
        line-height: 1;
      }

      p {
        color: var(--sl-color-gray-2);
        font-size: 1rem;
        line-height: 1.8;
      }

      a {
        margin-top: 1rem;
      }

      a:focus-visible {
        outline: 3px solid #bb9af7;
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <div style="color: var(--frame-accent); margin-bottom: 2rem"><BrandMark /></div>
      <p class="error-label">404 / UNCHARTED PATH</p>
      <h1>Lost ref.</h1>
      <p>This documentation path does not exist or has moved. Head back to the docs to find your next step.</p>
      <a class="primary-link" href={home}>Return to the docs <span aria-hidden="true">↗</span></a>
    </main>
  </body>
</html>
