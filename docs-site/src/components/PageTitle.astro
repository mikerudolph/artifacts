---
const { id, entry } = Astro.locals.starlightRoute;
---
<div class:list={["page-heading", { "article-heading": ["core/concepts", "core/integration"].includes(id) }]}>
  <h1 id="_top">{entry.data.title}</h1>
  <p class="page-description">{entry.data.description}</p>
</div>

<style>
  .page-heading.article-heading h1 { text-transform: none; letter-spacing: -.025em; font-family: var(--sl-font); font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.2; font-weight: 650; }
</style>
