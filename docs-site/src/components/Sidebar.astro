---
import { sections, sectionFor, docsHref } from '../navigation.mjs';
const { id } = Astro.locals.starlightRoute;
const current = sectionFor(id);
---
<div class="docs-sidebar">
  <nav aria-label={`${current.label} documentation`}>
    {current.groups.map((group) => <div class="sidebar-group">
      <h2>{group.label}</h2>
      <ul>{group.items.map((item) => <li><a href={docsHref(item.slug)} aria-current={id === item.slug ? 'page' : undefined}><span>{item.label}</span>{item.slug === 'getting-started' && <span class="quickstart-arrow" aria-hidden="true">↗</span>}</a></li>)}</ul>
    </div>)}
  </nav>
  <nav class="sidebar-explore" aria-label="Explore documentation">
    <h2>Explore</h2>
    {sections.filter((section) => section.id !== current.id).map((section) => <a href={docsHref(section.href)}>{section.label}<span aria-hidden="true">↗</span></a>)}
  </nav>
</div>
