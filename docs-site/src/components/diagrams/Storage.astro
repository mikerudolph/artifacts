---
import Diagram from './Diagram.astro';
import Transit from './Transit.astro';
const layouts = [
  { name: 'desktop', width: 688, height: 480, meta: { x: 24, y: 26, w: 230, h: 208 }, objects: { x: 278, y: 26, w: 386, h: 208 }, cache: { x: 148, y: 304, w: 392, h: 154 } },
  { name: 'mobile', width: 344, height: 596, meta: { x: 20, y: 16, w: 304, h: 130 }, objects: { x: 20, y: 178, w: 304, h: 182 }, cache: { x: 20, y: 422, w: 304, h: 154 } },
];
---

<Diagram story="storage">
  {layouts.map(({ name, width, height, meta, objects, cache }) => {
    const mobile = name === 'mobile';
    const metaRow = mobile ? 62 : 102;
    const objectRow = mobile ? 92 : 104;
    const slotWidth = (cache.w - 48) / 3;
    const slotCenter = (index: number) => cache.x + 16 + index * (slotWidth + 8) + slotWidth / 2;
    const bytesPath = mobile ? 'M172 360V422' : 'M471 234V270Q471 282 459 282H438V304';
    const refsPath = mobile ? 'M324 100H334V404Q334 412 326 412H288V422' : 'M139 234V270Q139 282 151 282H236V304';
    return (
      <svg class={`scene-${name} storage-scene`} viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false">
        <path d={bytesPath} class="edge edge-blue" data-draw="0.26 0.88" />
        <path d={refsPath} class="edge edge-purple" data-draw="0.08 0.62" />
        {!mobile && <>
          <text x="177" y="264" text-anchor="middle" class="tiny purple">refs + HEAD</text>
          <text x="405" y="264" text-anchor="middle" class="tiny blue">pack + index</text>
        </>}

        <g transform={`translate(${meta.x} ${meta.y})`}>
          <rect width={meta.w} height={meta.h} rx="7" class="panel" />
          <text x="16" y="29" class="title">Postgres</text>
          <text x={meta.w - 16} y="29" text-anchor="end" class="tiny purple">DURABLE</text>
          {!mobile && <>
            <text x="16" y="51" class="small">The publication record</text>
            <path d={`M16 69H${meta.w - 16}`} class="divider" />
          </>}
          <text x="16" y={metaRow} class="mono">checkpoint</text>
          <text x={meta.w - 16} y={metaRow} text-anchor="end" class="mono purple">#40</text>
          <text x="16" y={metaRow + 27} class="mono">pack_wal</text>
          <text x={meta.w - 16} y={metaRow + 27} text-anchor="end" class="mono purple">#41, #42</text>
          <text x="16" y={metaRow + 54} class="mono">main</text>
          <text x={meta.w - 16} y={metaRow + 54} text-anchor="end" class="mono purple">d4e5f6</text>
          {!mobile && <text x="16" y="186" class="tiny">metadata ≠ file bytes</text>}
          {[2, 3, 4].map((step, index) => (
            <rect x="8" y={metaRow - 16 + index * 27} width={meta.w - 16} height="24" rx="3" fill="none" stroke="var(--diagram-purple)" data-show={step} data-enter="0" data-span=".01" data-draw={`${step}.01 ${step}.26`} />
          ))}
        </g>

        <g transform={`translate(${objects.x} ${objects.y})`}>
          <rect width={objects.w} height={objects.h} rx="7" class="panel" />
          <text x="16" y="29" class="title">Object storage</text>
          <text x={objects.w - 16} y="29" text-anchor="end" class="tiny blue">DURABLE</text>
          <text x="16" y="54" class="mono small">{'{account}/{repo}/pack/'}</text>
          <path d={`M25 ${objectRow - 16}V${objectRow + 49}m0-55h12m-12 28h12m-12 27h12`} class="edge" />
          {['8ac1', 'b72e', 'c93f'].map((hash, i) => (
            <g>
              <text x="45" y={objectRow + i * 27} class="mono blue">{hash}….pack + .idx</text>
              <text x={objects.w - 16} y={objectRow + i * 27} text-anchor="end" class="tiny">#{40 + i}</text>
            </g>
          ))}
          {[0, 1, 2].map(index => (
            <rect x="36" y={objectRow - 16 + index * 27} width={objects.w - 44} height="23" rx="3" fill="none" stroke="var(--diagram-blue)" data-show={index === 0 ? '2' : '3'} data-enter={index === 2 ? '.40' : '0'} data-span=".05" data-draw={index === 0 ? '2.04 2.30' : index === 1 ? '3.02 3.25' : '3.40 3.65'} />
          ))}
          {!mobile && <text x="16" y="186" class="tiny">content-addressed, immutable pairs</text>}
        </g>

        <g transform={`translate(${cache.x} ${cache.y})`}>
          <rect width={cache.w} height={cache.h} rx="7" class="panel-raised" />
          <rect width={cache.w} height={cache.h} rx="7" class="edge dashed" data-show="1" />
          <rect width={cache.w} height={cache.h} rx="7" class="edge edge-green" data-show="4" data-enter=".64" data-span=".06" data-draw="4.64 4.94" />
          <text x="16" y="26" class="title">Local bare repository</text>
          <text x="16" y="49" class="tiny">{'{CACHE_DIR}/{account}/{repo_id}/'}</text>
          <text x="16" y="75" class="mono">objects/pack/</text>
          <text x={cache.w - 16} y="75" text-anchor="end" class="tiny" data-show="1" data-enter=".20">CACHE MISSING</text>
          {[0, 1, 2].map(index => {
            const x = 16 + index * (slotWidth + 8);
            return <>
              <rect x={x} y="86" width={slotWidth} height="34" rx="4" class="edge dashed ghost" />
              <g data-show={index === 0 ? '0 2 3 4' : '0 3 4'} data-enter={index === 0 ? '.70' : index === 1 ? '.51' : '.93'} data-span=".12" data-offset="0 10" data-scale=".96" data-pivot={`${x + slotWidth / 2} 103`}>
                <rect x={x} y="86" width={slotWidth} height="34" rx="4" class="node node-blue" />
                <path d={`M${x + 12} 95h9v13h-9Zm4-3h9v13`} class="edge edge-blue" />
                <text x={x + slotWidth / 2 + 12} y="107" text-anchor="middle" class="mono blue">#{40 + index}</text>
              </g>
            </>;
          })}
          <g data-show="0 4" data-enter=".68" data-span=".22" data-offset="0 12">
            <text x="16" y="140" class="mono purple">HEAD → refs/heads/main</text>
            <path d={`m${cache.w - 32} 135 5 5 10-12`} class="check" />
          </g>
        </g>
        <g data-show="1" data-enter=".20" data-offset="0 -6">
          <text x={width / 2} y={mobile ? 394 : 279} text-anchor="middle" class="tiny">DURABLE STATE IS UNCHANGED</text>
        </g>
        {[0, 1, 2].map(index => {
          const startX = objects.x + objects.w / 2;
          const startY = objects.y + objectRow + index * 27 - 4;
          const endX = slotCenter(index);
          const endY = cache.y + 103;
          const portX = cache.x + cache.w - 42;
          return <Transit start={index === 0 ? 2.12 : index === 1 ? 3.06 : 3.46} end={index === 0 ? 2.73 : index === 1 ? 3.54 : 3.96} route={`M${startX} ${startY}C${startX} ${objects.y + objects.h + 24} ${portX} ${objects.y + objects.h + 24} ${portX} ${cache.y - 12}V${endY - 20}Q${portX} ${endY} ${endX} ${endY}`} label={`#${40 + index}`} compact />;
        })}
        <g class="diagram-transit" data-transit="4.08 4.82" data-route={`${refsPath}V${cache.y + 140}`}>
          <circle r="8" fill="var(--diagram-purple)" opacity=".14" />
          <circle r="3" fill="var(--diagram-purple)" />
        </g>
      </svg>
    );
  })}
</Diagram>
