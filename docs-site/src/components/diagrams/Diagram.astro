---
import { stories, type StoryName } from './stories';
import '../../styles/diagrams.css';

interface Props { story: StoryName; playbackControl?: boolean; }
const { story: name, playbackControl = true } = Astro.props;
const story = stories[name];
const id = `diagram-${name}`;
const lastStep = story.steps.length - 1;
---

<artifact-diagram class="not-content" id={id} data-story={name} data-step={lastStep} data-playing="false">
  <figure aria-labelledby={`${id}-heading`} aria-describedby={`${id}-summary`}>
    <header class="diagram-heading">
      <div>
        <h3 id={`${id}-heading`}>{story.title}</h3>
      </div>
    </header>
    <p class="diagram-sr-only" id={`${id}-summary`}>{story.summary}</p>
    <div class="diagram-stage">
      <slot />
    </div>
    <div class="diagram-controls" role="group" aria-label={`${story.category} animation controls`}>
        {playbackControl && <button type="button" class="diagram-play" data-action="play" aria-label={`Play ${story.category.toLowerCase()} animation`}>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path class="play-symbol" d="m6 3 10 7-10 7Z" fill="currentColor" />
            <path class="pause-symbol" d="M6 4v12M14 4v12" fill="none" stroke="currentColor" stroke-width="3" />
          </svg>
          <span data-play-label>Play</span>
        </button>}
        <ol class="diagram-steps">
          {story.steps.map((step, index) => (
            <li>
              <button type="button" data-go={index} aria-label={`Step ${index + 1} of ${story.steps.length}: ${step.title}`} aria-current={index === lastStep ? 'step' : undefined}>
                <span class="step-track"><span></span></span>
                <span class="step-label">{step.label}</span>
              </button>
            </li>
          ))}
        </ol>
    </div>
    <figcaption>
      <div class="diagram-caption">
        <div class="diagram-caption-stack">
          {story.steps.map((step, index) => (
            <div data-caption={index} hidden={index !== lastStep}>
              <strong>{step.title}</strong>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
      <details class="diagram-transcript">
        <summary>Read every step <span aria-hidden="true">↗</span></summary>
        <ol>
          {story.steps.map(step => <li><strong>{step.title}.</strong> {step.description}</li>)}
        </ol>
        <p>{story.note}</p>
      </details>
      <noscript><p class="diagram-no-script">Animation is optional. Open “Read every step” for the full explanation.</p></noscript>
      <span class="diagram-sr-only" role="status" data-announcement></span>
    </figcaption>
  </figure>
</artifact-diagram>

<script>
  import '../../scripts/diagrams';
</script>
